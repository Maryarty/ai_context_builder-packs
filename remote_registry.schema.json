{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context-builder.local/schemas/remote_registry.schema.json",
  "title": "AI Context Builder Remote Pack Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["packs"],
  "properties": {
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packEntry"
      }
    }
  },
  "$defs": {
    "packEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "displayName", "supportedLanguages", "versions"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["language", "framework", "library", "workspace-convention"]
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "supportedLanguages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/versionEntry"
          }
        }
      }
    },
    "versionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "downloadUrl", "minExtensionVersion"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "enum": ["stable", "beta"],
          "description": "Release channel for this version. Absent is treated as 'stable'. Stable clients see only stable versions; beta clients see both stable and beta."
        },
        "format": {
          "type": "string",
          "enum": ["aiclp-envelope-v1"],
          "description": "Archive format of the download. Absent is treated as the signed envelope format ('aiclp-envelope-v1'), the only format the runtime accepts."
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Optional lowercase-hex SHA-256 of the whole .aiclp file, used for a download cache / integrity pre-check. The cryptographic trust boundary is the envelope signature, not this value."
        },
        "minExtensionVersion": {
          "type": "string",
          "minLength": 1
        },
        "maxExtensionVersion": {
          "type": "string",
          "minLength": 1
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}